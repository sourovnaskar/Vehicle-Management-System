<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Service History - VSMS</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f4f7f6;
            margin: 0;
            padding: 20px;
        }
        .container {
            max-width: 1300px;
            margin: 0 auto;
            background: white;
            padding: 25px;
            border-radius: 10px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        }
        
        /* Back Button */
        .btn-back {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: #555;
            text-decoration: none;
            font-size: 0.95rem;
            font-weight: 600;
            padding: 8px 15px;
            background-color: #e9ecef;
            border-radius: 6px;
            transition: all 0.3s ease;
            margin-bottom: 20px;
        }
        .btn-back:hover {
            background-color: #fd7e14;
            color: white;
        }

        .header-container {
            border-bottom: 2px solid #fd7e14;
            padding-bottom: 10px;
            margin-bottom: 20px;
        }
        h1 { color: #333; margin: 0; font-size: 1.8rem; }

        /* Table Styling */
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 10px;
        }
        th, td {
            padding: 15px;
            text-align: left;
            border-bottom: 1px solid #eee;
            vertical-align: middle;
        }
        th {
            background-color: #f8f9fa;
            color: #444;
            font-weight: 600;
        }
        tr:hover { background-color: #fff8f3; }

        /* Typography & Badges */
        .customer-name { font-weight: 700; color: #2c3e50; font-size: 1.05em; }
        .vehicle-meta { color: #6c757d; font-size: 0.85em; display: block; margin-top: 4px; }
        
        .badge {
            padding: 5px 10px;
            border-radius: 12px;
            font-size: 0.8em;
            font-weight: bold;
        }
        .status-completed { background-color: #d4edda; color: #155724; }
        .status-invoice { background-color: #cce5ff; color: #004085; }
        
        .mechanic-name {
            background: #f1f3f5;
            padding: 4px 10px;
            border-radius: 4px;
            font-size: 0.9em;
            color: #495057;
        }

        .cost-text { font-weight: bold; color: #28a745; font-size: 1.1em; }
        
        .notes-cell {
            max-width: 250px;
            font-size: 0.85em;
            color: #555;
            line-height: 1.4;
        }

        /* Image Thumbnails */
        .img-container {
            display: flex;
            gap: 5px;
            flex-wrap: wrap;
        }
        .thumbnail {
            width: 45px;
            height: 45px;
            border-radius: 5px;
            object-fit: cover;
            border: 1px solid #ddd;
            cursor: pointer;
            transition: transform 0.2s;
        }
        .thumbnail:hover {
            transform: scale(1.1);
        }

        .empty-state { text-align: center; padding: 40px; color: #666; font-style: italic; }
    </style>
</head>
<body>

    <div class="container">
        <a href="javascript:history.back()" class="btn-back">
            <i class="fa-solid fa-arrow-left"></i> Back
        </a>

        <div class="header-container">
            <h1>Service & Billing History</h1>
        </div>
        
        <table>
            <thead>
                <tr>
                    <th>Customer & Vehicle</th>
                    <th>Mechanic</th>
                    <th>Service Details</th>
                    <th>Repair Notes</th>
                    <th>After Images</th>
                    <th>Final Cost</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                <% if (history && history.length > 0) { %>
                    <% history.forEach(function(job) { %>
                        <tr>
                            <td>
                                <span class="customer-name"><%= job.userDetails.name %></span>
                                <span class="vehicle-meta">
                                    <i class="fa-solid fa-motorcycle"></i> <%= job.vehicleDetails.brand %> <%= job.vehicleDetails.model %> 
                                    <br> <i class="fa-solid fa-id-card"></i> <%= job.vehicleDetails.vehicleNumber %>
                                </span>
                            </td>
                            
                            <td>
                                <span class="mechanic-name">
                                    <i class="fa-solid fa-wrench"></i> <%= job.mechanicDetails.name %>
                                </span>
                            </td>
                            
                            <td>
                                <% if (Array.isArray(job.serviceType)) { %>
                                    <%= job.serviceType.join(', ') %>
                                <% } else { %>
                                    <%= job.serviceType || 'Standard Service' %>
                                <% } %>
                            </td>
                            
                            <td class="notes-cell">
                                <%= job.repairNotes || job.description || 'No notes provided.' %>
                            </td>

                            <td>
                                <div class="img-container">
                                    <% if (job.afterImages && job.afterImages.length > 0) { %>
                                        <% job.afterImages.forEach(function(imgUrl) { %>
                                            <a href="<%= imgUrl %>" target="_blank">
                                                <img src="<%= imgUrl %>" alt="Post-service photo" class="thumbnail">
                                            </a>
                                        <% }); %>
                                    <% } else { %>
                                        <span style="font-size: 0.8em; color: #999;">No images</span>
                                    <% } %>
                                </div>
                            </td>

                            <td>
                                <% if (job.finalCost) { %>
                                    <span class="cost-text">₹<%= job.finalCost %></span>
                                <% } else { %>
                                    <span style="color: #999;">Pending</span>
                                <% } %>
                            </td>

                            <td>
                                <% if (job.status === 'Completed') { %>
                                    <span class="badge status-completed">Ready for Pickup</span>
                                <% } else if (job.status === 'Invoice-generate') { %>
                                    <span class="badge status-invoice">Invoice Generated</span>
                                <% } else { %>
                                    <span class="badge"><%= job.status %></span>
                                <% } %>
                            </td>
                        </tr>
                    <% }); %>
                <% } else { %>
                    <tr>
                        <td colspan="7" class="empty-state">No completed service records found.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>

</body>
</html>