<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<style>
    /* Custom subtle tweaks for a premium feel */
    .table-custom th {
        background-color: #f8f9fc;
        color: #4e73df;
        font-weight: 700;
        text-transform: uppercase;
        font-size: 0.8rem;
        letter-spacing: 0.05rem;
    }
    .table-custom td {
        vertical-align: middle;
        color: #5a5c69;
    }
    .btn-generate {
        background: linear-gradient(135deg, #4e73df 0%, #224abe 100%);
        color: white;
        border: none;
        border-radius: 6px;
        padding: 6px 16px;
        font-size: 0.85rem;
        font-weight: 600;
        transition: all 0.3s ease;
    }
    .btn-generate:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 10px rgba(78, 115, 223, 0.3);
        color: white;
    }
</style>

<div id="content-wrapper" class="d-flex flex-column">
    <div id="content">
        <%- include('partials/topbar') %>

        <div class="container-fluid">

            <div class="d-sm-flex align-items-center justify-content-between mb-4">
                <h1 class="h3 mb-0 text-gray-800 font-weight-bold">Billing & Invoices</h1>
                <p class="mb-0 text-gray-500">Manage completed services waiting for invoice generation.</p>
            </div>

            <% if (typeof successMsg !== 'undefined' && successMsg.length > 0) { %>
                <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                    <i class="fas fa-check-circle mr-2"></i><%=successMsg %>
                    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
            <% } %>
            
            <% if (typeof errorMsg !== 'undefined' && errorMsg.length > 0) { %>
                <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                    <i class="fas fa-exclamation-triangle mr-2"></i><%= errorMsg %>
                    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
            <% } %>

            <div class="card shadow mb-4 border-0">
                <div class="card-header py-3 bg-white border-bottom-primary">
                    <h6 class="m-0 font-weight-bold text-primary">Services Ready for Billing</h6>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover table-custom" id="dataTable" width="100%" cellspacing="0">
                            <thead>
                                <tr>
                                    <th>Job ID</th>
                                    <th>Customer Name</th>
                                    <th>Vehicle Details</th>
                                    <th>Service Cost</th>
                                    <th>Status</th>
                                    <th class="text-center">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (typeof services !== 'undefined' && services.length > 0) { %>
                                    <% services.forEach(service => { %>
                                        <tr>
                                            <td class="font-weight-bold">#<%= service._id.toString().slice(-6).toUpperCase() %></td>
                                            
                                            <td><%= service.customerId ? service.customerId.name : 'Unknown' %></td>
                                            <td>
                                                <% if (service.vehicleId) { %>
                                                    <%= service.vehicleId.brand %> <%= service.vehicleId.model %>
                                                    <br>
                                                    <small class="text-muted font-weight-bold"><%= service.vehicleId.vehicleNumber %></small>
                                                <% } else { %>
                                                    N/A
                                                <% } %>
                                            </td>
                                            
                                            <td class="font-weight-bold text-success">₹<%= service.finalCost %></td>
                                            
                                            <td>
                                                <span class="badge badge-success px-2 py-1"><%= service.status %></span>
                                            </td>
                                            
                                            <td class="text-center">
                                                <form action="/admin/generate-invoice/<%= service._id %>" method="POST" class="d-inline">
                                                    <button type="submit" class="btn-generate">
                                                        <i class="fas fa-file-invoice mr-1"></i> Generate
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="6" class="text-center py-4 text-muted">
                                            <i class="fas fa-inbox fa-2x mb-3 d-block text-gray-300"></i>
                                            No completed services waiting for billing.
                                        </td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

        </div>
    </div> <%- include('partials/footer') %>

</div> <%- include('partials/script') %>