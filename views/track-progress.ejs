<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Track Progress - AutoSpace</title>

    <script src="https://cdn.tailwindcss.com"></script>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        /* Sidebar Hover & Click Transitions */
        body { margin: 0; display: flex; min-height: 100vh; background-color: #f8f9fc; }
        
        .sidebar {
            transition: width 0.3s ease-in-out;
            width: 70px;
            overflow: hidden;
            min-height: 100vh;
        }

        .sidebar:hover,
        .sidebar.expanded {
            width: 250px;
        }

        .sidebar .nav-text {
            opacity: 0;
            transition: opacity 0.2s ease;
            white-space: nowrap;
        }

        .sidebar:hover .nav-text,
        .sidebar.expanded .nav-text {
            opacity: 1;
            transition-delay: 0.1s;
        }
        
        #content-wrapper {
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            overflow-x: hidden;
        }
    </style>
</head>
<body>

    <aside class="sidebar bg-slate-900 text-white flex flex-col shadow-2xl z-20 relative" id="sidebar" onclick="this.classList.toggle('expanded')">
        <div class="h-16 flex items-center px-6 border-b border-slate-700 cursor-pointer">
            <i class="fa-solid fa-bars text-xl text-slate-300"></i>
            <span class="nav-text ml-4 font-bold text-lg tracking-wider text-indigo-400">MENU</span>
        </div>

        <nav class="flex-1 pt-4">
            <a href="/vehicle/track-progress" class="flex items-center px-6 py-4 hover:bg-slate-800 transition-colors border-l-4 border-transparent hover:border-indigo-500 text-white text-decoration-none">
                <i class="fa-solid fa-chart-line text-xl min-w-[24px] text-slate-300"></i>
                <span class="nav-text ml-4 font-medium">Track Progress</span>
            </a>
        </nav>
    </aside>

    <div id="content-wrapper">

        <div id="content">
            
            <header class="h-16 bg-white shadow-sm flex items-center justify-between px-8 border-b border-gray-200 sticky top-0 z-10">
                <div class="text-2xl font-black text-indigo-600 tracking-tight">
                    Auto<span class="text-slate-800">Space</span>
                </div>

                <div class="flex items-center gap-6">
                    <div class="flex items-center gap-2 text-slate-700 bg-slate-100 px-4 py-1.5 rounded-full font-medium shadow-inner">
                        <i class="fa-solid fa-user-circle text-indigo-500 text-lg"></i>
                        <span><%= user.name %></span>
                    </div>
                    <a href="/logout" class="text-red-500 hover:text-red-700 hover:bg-red-50 px-3 py-1.5 rounded-md font-semibold transition-all flex items-center gap-2 text-decoration-none">
                        <i class="fa-solid fa-right-from-bracket"></i> Logout
                    </a>
                </div>
            </header>

            <div class="container-fluid mt-4 px-4">

                <div class="d-sm-flex align-items-center justify-content-between mb-4">
                    <h1 class="h3 mb-0 text-gray-800">
                        <i class="fas fa-tasks text-gray-400 mr-2"></i> Track Service Progress
                    </h1>
                </div>

                <% if (locals.success && locals.success.length > 0) { %>
                    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                        <i class="fas fa-check-circle mr-2"></i> <%= success %>
                    </div>
                <% } %>
                <% if (locals.error && locals.error.length > 0) { %>
                    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                        <i class="fas fa-exclamation-circle mr-2"></i> <%= error %>
                    </div>
                <% } %>

                <div class="row">
                    <% if (activeServices && activeServices.length > 0) { %>
                        <% activeServices.forEach(service => { 
                            
                            // Dynamic Progress Bar Logic
                            let progressWidth = '5%';
                            let progressColor = 'bg-secondary';
                            let statusIcon = 'fa-clock';
                            let statusMessage = 'Awaiting Details';

                            if (service.status === 'Pending') {
                                progressWidth = '25%';
                                progressColor = 'bg-warning';
                                statusIcon = 'fa-pause-circle';
                                statusMessage = 'In Queue (Waiting for Mechanic)';
                            } else if (service.status === 'In Progress') {
                                progressWidth = '65%';
                                progressColor = 'bg-primary';
                                statusIcon = 'fa-tools';
                                statusMessage = 'Mechanic is actively working on your vehicle';
                            } else if (service.status === 'Completed') {
                                progressWidth = '100%';
                                progressColor = 'bg-success';
                                statusIcon = 'fa-check-circle';
                                statusMessage = 'Service Complete! Ready for pickup.';
                            }
                        %>
                        
                        <div class="col-lg-8 mb-4">
                            <div class="card shadow mb-4 border-0">
                                <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between bg-white border-bottom">
                                    <h6 class="m-0 font-weight-bold text-primary">
                                        <%= service.vehicleDetails ? service.vehicleDetails.brand : '' %> 
                                        <%= service.vehicleDetails ? service.vehicleDetails.model : 'Your Vehicle' %>
                                    </h6>
                                    <span class="badge badge-pill badge-light border px-3 py-2 text-uppercase text-secondary">
                                        <%= service.vehicleDetails ? service.vehicleDetails.vehicleNumber : 'N/A' %>
                                    </span>
                                </div>
                                
                                <div class="card-body">
                                    <h4 class="small font-weight-bold mb-2">Service Status: <span class="float-right text-<%= progressColor.split('-')[1] %>"><%= service.status %></span></h4>
                                    <div class="progress mb-4" style="height: 20px; background-color: #eaecf4;">
                                        <div class="progress-bar <%= progressColor %> progress-bar-striped progress-bar-animated" role="progressbar" style="width: <%= progressWidth %>;" aria-valuenow="<%= parseInt(progressWidth) %>" aria-valuemin="0" aria-valuemax="100"></div>
                                    </div>
                                    
                                    <div class="text-center mb-4 mt-4">
                                        <h5 class="text-gray-800"><i class="fas <%= statusIcon %> text-gray-500 mr-2"></i> <%= statusMessage %></h5>
                                    </div>

                                    <hr>

                                    <div class="row text-sm">
                                        <div class="col-md-6 mb-3">
                                            <div class="text-gray-500 font-weight-bold text-uppercase mb-1">Requested Services</div>
                                            <div class="text-gray-800">
                                                <%= (service.serviceType && service.serviceType.length > 0) ? service.serviceType.join(', ') : 'General Inspection' %>
                                            </div>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <div class="text-gray-500 font-weight-bold text-uppercase mb-1">Promised By</div>
                                            <div class="text-gray-800 font-weight-bold">
                                                <%= service.preferredDate ? new Date(service.preferredDate).toLocaleDateString('en-IN', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) : 'TBD' %>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <% if(service.description) { %>
                                        <div class="mt-3 bg-light p-3 rounded border">
                                            <span class="text-gray-500 font-weight-bold text-xs text-uppercase">Your Complaint/Note:</span>
                                            <p class="mb-0 small text-gray-700 mt-2"><%= service.description %></p>
                                        </div>
                                    <% } %>

                                </div>
                            </div>
                        </div>
                        
                        <% }) %>
                    <% } else { %>
                        <div class="col-lg-8">
                            <div class="card shadow mb-4 border-0">
                                <div class="card-body text-center py-5">
                                    <i class="fas fa-motorcycle fa-4x text-gray-300 mb-4"></i>
                                    <h4 class="text-gray-700 font-weight-bold">No active services</h4>
                                    <p class="text-gray-500 mb-4">You don't have any vehicles currently in the shop.</p>
                                    <a href="/user/book-service" class="btn btn-primary px-4 py-2">
                                        <i class="fas fa-plus fa-sm text-white-50 mr-2"></i> Book a New Service
                                    </a>
                                </div>
                            </div>
                        </div>
                    <% } %>
                </div>

            </div>
        </div>
    </div>
    
    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>