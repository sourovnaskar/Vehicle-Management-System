<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<div id="content-wrapper" class="d-flex flex-column">

    <div id="content">
        <%- include('partials/topbar') %>

        <div class="container-fluid">

            <div class="d-sm-flex align-items-center justify-content-between mb-4">
                <h1 class="h3 mb-0 text-gray-800">
                    <i class="fas fa-history text-gray-400 mr-2"></i> My Service History
                </h1>
            </div>

            <%- include('partials/messages') %>

            <div class="card shadow mb-4 border-bottom-success">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-success">Completed Jobs Log</h6>
                </div>
                <div class="card-body">
                    
                    <% if (jobs && jobs.length > 0) { %>
                        <div class="table-responsive">
                            <table class="table table-bordered table-hover" id="dataTable" width="100%" cellspacing="0">
                                <thead class="thead-light">
                                    <tr>
                                        <th>Date Completed</th>
                                        <th>Customer Name</th>
                                        <th>Vehicle</th>
                                        <th>Reg. Number</th>
                                        <th>Services Performed</th>
                                        <th>Final Cost</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% jobs.forEach(job => { %>
                                        <tr>
                                            <td><%= job.updatedAt ? new Date(job.updatedAt).toLocaleDateString('en-IN') : 'N/A' %></td>
                                            
                                            <td class="font-weight-bold">
                                                <%= job.customerDetail ? job.customerDetail.name : 'Unknown Customer' %>
                                            </td>
                                            
                                            <td class="font-weight-bold text-primary">
                                                <%= job.vehiclesDetail ? job.vehiclesDetail.brand : '' %> 
                                                <%= job.vehiclesDetail ? job.vehiclesDetail.model : 'Unknown Vehicle' %>
                                            </td>
                                            
                                            <td><%= job.vehiclesDetail ? job.vehiclesDetail.vehicleNumber : 'N/A' %></td>
                                            
                                            <td>
                                                <span class="d-inline-block text-truncate" style="max-width: 200px;">
                                                    <%= (job.serviceType && job.serviceType.length > 0) ? job.serviceType.join(', ') : 'None' %>
                                                </span>
                                            </td>
                                            
                                            <td>
                                                <% if (job.finalCost) { %>
                                                    <span class="text-success font-weight-bold">₹<%= job.finalCost %></span>
                                                <% } else { %>
                                                    <span class="text-muted">N/A</span>
                                                <% } %>
                                            </td>
                                            
                                            <td>
                                                <span class="badge badge-success"><i class="fas fa-check-circle mr-1"></i> <%= job.status %></span>
                                            </td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    <% } else { %>
                        <div class="text-center py-5">
                            <i class="fas fa-clipboard-check fa-4x text-gray-300 mb-3"></i>
                            <h5 class="text-gray-600">No completed jobs yet.</h5>
                            <p class="text-gray-500 mb-0">Once you finish working on vehicles, your history will appear here.</p>
                        </div>
                    <% } %>

                </div>
            </div>

        </div>
        </div>
    <%- include('partials/footer') %>
<%- include('partials/scripts') %>