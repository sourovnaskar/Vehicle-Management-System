<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<div id="content-wrapper" class="d-flex flex-column">

    <div id="content">

        <%- include('partials/topbar') %>

        <div class="container-fluid">

            <div class="d-sm-flex align-items-center justify-content-between mb-4">
                <h1 class="h3 mb-0 text-gray-800">My Queue (Active Jobs)</h1>
            </div>

            <div class="row">

                <% if (jobs && jobs.length > 0) { %>
                    <% jobs.forEach(job => { 
                        
                        // Dynamic styling based on the status of the job
                        let borderClass = 'border-left-warning'; // Default for Pending
                        let textClass = 'text-warning';
                        let iconClass = 'fa-clock';
                        
                        if (job.status === 'In Progress') {
                            borderClass = 'border-left-primary';
                            textClass = 'text-primary';
                            iconClass = 'fa-tools';
                        }
                    %>
                    
                    <div class="col-xl-4 col-md-6 mb-4">
                        <div class="card <%= borderClass %> shadow h-100 py-2">
                            <div class="card-body d-flex flex-column">
                                <div class="row no-gutters align-items-center flex-grow-1">
                                    <div class="col mr-2">
                                        
                                        <div class="text-xs font-weight-bold <%= textClass %> text-uppercase mb-1">
                                            <i class="fas <%= iconClass %>"></i> <%= job.status %>
                                        </div>
                                        
                                        <div class="h5 mb-0 font-weight-bold text-gray-800 mt-2">
                                            <%= job.vehicleDetails ? job.vehicleDetails.brand : 'Unknown' %> 
                                            <%= job.vehicleDetails ? job.vehicleDetails.model : 'Vehicle' %>
                                        </div>
                                        <div class="text-sm text-gray-500 mb-3">
                                            <%= job.vehicleDetails ? job.vehicleDetails.vehicleNumber : 'No Plate Assigned' %>
                                        </div>
                                        
                                        <p class="mb-3 text-gray-700 small">
                                            <strong>Services:</strong> <%= job.serviceType.join(', ') %><br>
                                            <strong>Issue:</strong> <%= job.description || 'No specific description provided by customer.' %>
                                        </p>
                                        
                                    </div>
                                </div>
                                
                                <a href="/mechanic/job/<%= job._id %>" class="btn btn-primary btn-sm btn-block shadow-sm mt-3">
                                    <i class="fas fa-wrench fa-sm text-white-50 mr-1"></i> Open Job Card
                                </a>
                            </div>
                        </div>
                    </div>
                    
                    <% }) %>
                <% } else { %>
                    
                    <div class="col-12 mt-4">
                        <div class="alert alert-success text-center shadow-sm py-4" role="alert">
                            <i class="fas fa-check-circle fa-3x mb-3 mt-2 d-block text-success"></i>
                            <h4 class="alert-heading">All caught up!</h4>
                            <p class="mb-0">You have no active vehicles in your queue right now. Great job!</p>
                        </div>
                    </div>
                    
                <% } %>

            </div>
            </div>
        </div>
    <%- include('partials/footer') %>
<%- include('partials/scripts') %>